{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 6,
  "modules-left": ["custom/logo", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/fleasion", "mpris", "pulseaudio", "network", "cpu", "memory", "battery", "tray", "custom/notifications", "custom/power"],

  "custom/logo": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "wofi --show drun",
    "on-click-right": "powermenu"
  },
  "custom/power": { "format": "󰐥", "tooltip": false, "on-click": "powermenu" },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": { "active": "", "default": "", "empty": "" },
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },
  "hyprland/window": { "max-length": 40, "separate-outputs": true },
  "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "  {:%a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": { "format": { "today": "<span color='#d4b86a'><b>{}</b></span>" } }
  },
  "mpris": {
    "format": "{status_icon} {title}",
    "status-icons": { "playing": "", "paused": "" },
    "max-length": 30
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": { "default": ["", "", ""], "headphone": "󰋋" },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰖪 offline",
    "tooltip-format": "{ifname} · {ipaddr}"
  },
  "custom/fleasion": {
    "exec": "~/.config/waybar/scripts/fleasion-status.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "pkill -f 'fleasion.*launcher.py' || setsid -f ~/fleasion-wt/issue115/.venv/bin/python ~/fleasion-wt/issue115/launcher.py"
  },
  "cpu": { "format": " {usage}%", "interval": 3 },
  "memory": { "format": " {percentage}%", "interval": 5 },
  "battery": {
    "states": { "warning": 25, "critical": 12 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },
  "tray": { "icon-size": 16, "spacing": 8 },
  "custom/notifications": {
    "format": "{icon}",
    "format-icons": { "notification": "󱅫", "none": "󰂚", "dnd-notification": "󰂛", "dnd-none": "󰂛" },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true
  }
}
